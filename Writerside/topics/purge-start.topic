<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd" title="/purge start" id="purge-start">
    <tldr><p><format style="italic">Start processing the queued purge wave.</format></p></tldr>
    <chapter title="Description" id="description"><p>Enables the current server's purge wave so the bot begins processing its queued role removals.</p><warning><p>An active purge cannot be stopped or cleared through the purge commands. Check <a href="purge-progress.topic"/> before starting.</p></warning></chapter>
    <chapter title="Arguments" id="arguments" collapsible="true"><p>This command takes no arguments.</p></chapter>
    <chapter title="Examples" id="examples" collapsible="true"><code-block lang="bash">/purge start</code-block></chapter>
    <chapter title="See Also" id="see-also"><list><li><a href="purge-progress.topic"/></li></list></chapter>
</topic>
