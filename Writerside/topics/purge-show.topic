<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd" title="/purge show" id="purge-show">
    <tldr><p><format style="italic">Preview members affected by a purge.</format></p></tldr>
    <chapter title="Description" id="description"><p>Calculates and displays members who hold roles associated with the selected purge type and have default score below the threshold. This command does not queue or remove any roles. It warns if the carry type still has logs awaiting approval.</p></chapter>
    <chapter title="Arguments" id="arguments" collapsible="true"><table style="header-row"><tr><td>Name</td><td>Type</td><td>Description</td><td>Optional?</td><td>Additional</td></tr><tr><td><code>carry-type</code></td><td>String</td><td>Carry-type identifier.</td><td>:x: No</td><td>Max length: 30; autocomplete available.</td></tr><tr><td><code>purge-type</code></td><td>String</td><td>Purge-type identifier.</td><td>:x: No</td><td>Max length: 30; autocomplete available.</td></tr><tr><td><code>threshold</code></td><td>Integer</td><td>Members with less default score are included.</td><td>:x: No</td><td>Min: 0; max: 100.</td></tr></table></chapter>
    <chapter title="Examples" id="examples" collapsible="true"><code-block lang="bash">/purge show carry-type: dungeons purge-type: inactive threshold: 20</code-block></chapter>
    <chapter title="See Also" id="see-also"><list><li><a href="purge-add.topic"/></li></list></chapter>
</topic>
