<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd" id="role-requirements-add" title="/role requirements add">
    <tldr><p><format style="italic">Create an automatic role requirement.</format></p></tldr>
    <chapter title="Description" id="description"><p>Creates a requirement for a Discord role. The selected player value is compared with <code>count</code> whenever roles are synchronized. Use <code>extra-data</code> only when required by the selected <a href="Role-Requirement-Type.md">requirement type</a>.</p></chapter>
    <chapter title="Arguments" id="arguments" collapsible="true"><table style="header-row"><tr><td>Name</td><td>Type</td><td>Description</td><td>Optional?</td></tr><tr><td><code>role</code></td><td>Role</td><td>Role controlled by the requirement.</td><td>:x: No</td></tr><tr><td><code>requirement-type</code></td><td>Enumeration</td><td>Player or account value to evaluate.</td><td>:x: No</td></tr><tr><td><code>comparison</code></td><td>Enumeration</td><td>How the value is compared with the count.</td><td>:x: No</td></tr><tr><td><code>count</code></td><td>Integer</td><td>Value that must be compared against.</td><td>:x: No</td></tr><tr><td><code>extra-data</code></td><td>String</td><td>Additional value used by certain requirement types.</td><td>:white_check_mark: Yes</td></tr></table></chapter>
    <chapter title="Examples" id="examples" collapsible="true"><code-block lang="bash">/role requirements add role: @Experienced requirement-type: Skyblock Level comparison: Greater Or Equal count: 200</code-block></chapter>
    <chapter title="See Also" id="see-also"><list><li><a href="role-requirements-edit.topic"/></li><li><a href="Role-Requirement-Type.md"/></li></list></chapter>
</topic>
