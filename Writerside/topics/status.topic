<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="/status" id="status">
    <tldr>
        <p><format style="italic">Check whether a Minecraft player is online on Hypixel.</format></p><p><br/></p>
        <p><format style="bold">Allowed in DMs:</format> :white_check_mark: Yes</p>
        <p><format style="bold">Default permission required:</format> <code>None</code></p>
    </tldr>
    <chapter title="Description" id="description">
        <p>Shows whether the selected player is online. When available, an online result includes their current game, mode, and map; an offline result includes when they were last seen and the length of their last session.</p>
        <p>If <code>ign</code> is omitted in a ticket channel, the command checks the ticket creator. Otherwise, it checks the Minecraft account linked to the command issuer.</p>
    </chapter>
    <chapter title="Arguments" id="arguments" collapsible="true">
        <table style="header-row"><tr><td>Name</td><td>Type</td><td>Description</td><td>Optional?</td><td>Additional</td></tr><tr><td><code>ign</code></td><td>String</td><td>IGN to check instead of the automatically selected linked player.</td><td>:white_check_mark: Yes</td><td>Min length: 2</td></tr></table>
    </chapter>
    <chapter title="Examples" id="examples" collapsible="true"><code-block lang="bash">/status ign: Taubsie</code-block></chapter>
    <chapter title="See Also" id="see-also"><list><li><a href="link.topic"/></li><li><a href="player.topic"/></li></list></chapter>
</topic>
