<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd" id="role-requirements-list" title="/role requirements list">
    <tldr><p><format style="italic">List all role requirements configured in the server.</format></p></tldr>
    <chapter title="Description" id="description"><p>Displays every configured role requirement in a paginator. Use the displayed IDs to edit or delete individual requirements.</p></chapter>
    <chapter title="Arguments" id="arguments" collapsible="true"><p>This command takes no arguments.</p></chapter>
    <chapter title="Examples" id="examples" collapsible="true"><code-block lang="bash">/role requirements list</code-block></chapter>
    <chapter title="See Also" id="see-also"><list><li><a href="role-requirements-get.topic"/></li></list></chapter>
</topic>
